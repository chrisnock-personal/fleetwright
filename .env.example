# Required: encrypts stored SSH keys and signs sessions. Changing it makes
# stored keys unreadable. Generate one with:
#   openssl rand -hex 32     or     python3 -c 'import secrets; print(secrets.token_hex(32))'
FLEETWRIGHT_SECRET_KEY=

# The address browsers and agents use to reach FleetWright. Its host name goes
# into the self-signed certificate made on first start.
FLEETWRIGHT_PUBLIC_URL=https://192.0.2.10:8443
# More names or addresses for the self-signed certificate, comma-separated.
# FLEETWRIGHT_TLS_NAMES=fleetwright.lan
# HTTPS is on by default. "off" serves plain HTTP on 8080 for a TLS proxy in front;
# then set FLEETWRIGHT_PUBLIC_URL to the proxy's https address.
# FLEETWRIGHT_TLS=on
# Secure (HTTPS-only) session cookies follow FLEETWRIGHT_TLS unless set here.
# FLEETWRIGHT_SECURE_COOKIES=true

# Where FleetWright listens on the host (compose). Localhost only by default.
HTTPS_EXPOSE=0.0.0.0:8443
HTTP_EXPOSE=0.0.0.0:8080

POSTGRES_USER=fleetwright
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fleetwright

# Worker tuning (defaults shown)
# FLEETWRIGHT_SSH_CONCURRENCY=50
# FLEETWRIGHT_SCAN_INTERVAL_MIN=360
# FLEETWRIGHT_TASK_TIMEOUT=3600
# FLEETWRIGHT_REBOOT_WAIT=600
