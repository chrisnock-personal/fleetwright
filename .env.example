# Required: encrypts stored SSH keys and notification secrets, and signs sessions.
# Generate one with:
#   openssl rand -hex 32     or     python3 -c 'import secrets; print(secrets.token_hex(32))'
FLEETWRIGHT_SECRET_KEY=
# To change it: put the new key above and the old one here, restart, and FleetWright
# re-encrypts everything under the new key (the log says so); then remove this line.
# Everyone has to sign in again.
# FLEETWRIGHT_SECRET_KEY_PREVIOUS=

# The address browsers and agents use to reach FleetWright. Its host name goes
# into the self-signed certificate made on first start.
FLEETWRIGHT_PUBLIC_URL=https://192.0.2.10:8443
# More names or addresses for the self-signed certificate, comma-separated.
# FLEETWRIGHT_TLS_NAMES=fleetwright.lan
# HTTPS is on by default. "off" serves plain HTTP on 8080 for a TLS proxy in front;
# then set FLEETWRIGHT_PUBLIC_URL to the proxy's https address.
# FLEETWRIGHT_TLS=on
# Secure (HTTPS-only) session cookies follow FLEETWRIGHT_TLS unless set here.
# FLEETWRIGHT_SECURE_COOKIES=true

# Where FleetWright listens on the host (compose). Localhost only by default.
HTTPS_EXPOSE=0.0.0.0:8443
HTTP_EXPOSE=0.0.0.0:8080

POSTGRES_USER=fleetwright
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fleetwright

# The bundled Postgres is local to the compose network and needs no TLS settings.
# For a database on another host, point DATABASE_URL at it (the compose files set
# POSTGRES_HOST=db themselves), then opt into TLS. libpq sslmode values: disable,
# allow, prefer, require, verify-ca, verify-full. verify-full checks both the CA
# and the server name in the certificate.
# FLEETWRIGHT_DB_SSLMODE=verify-full
# Path *inside* the FleetWright container to the CA PEM; mount it there as shown
# in README ("Remote Postgres over TLS"). Without either of these two settings,
# DATABASE_URL is used exactly as written; when set, they replace sslmode and
# sslrootcert in its query string rather than adding duplicates.
# FLEETWRIGHT_DB_SSLROOTCERT=/etc/fleetwright/db-ca.pem

# Backups (docker compose --profile backup up -d): the database and the HTTPS
# certificate, encrypted to these public keys. age keys (age-keygen) or SSH public
# keys, comma-separated; keep the private key off this server, with a copy of
# FLEETWRIGHT_SECRET_KEY. Restore with backup/restore.sh.
# BACKUP_AGE_RECIPIENTS=age1...
# BACKUP_AT=03:30          # daily, UTC
# BACKUP_KEEP=14
# BACKUP_DIR=./backups     # on this host; copy it somewhere else too

# Worker tuning (defaults shown)
# FLEETWRIGHT_SSH_CONCURRENCY=50
# FLEETWRIGHT_SCAN_INTERVAL_MIN=360
# FLEETWRIGHT_TASK_TIMEOUT=3600
# FLEETWRIGHT_REBOOT_WAIT=600
